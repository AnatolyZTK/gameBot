<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: system-ui, sans-serif;
            background: #1a1a2e;
            color: #eee;
        }
        .window {
            width: min(480px, 92vw);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 24px 48px rgba(0, 0, 0, 0.45);
            border: 1px solid #333;
        }
        .window-titlebar {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 16px;
            background: #16213e;
            border-bottom: 1px solid #333;
        }
        .window-titlebar span.dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }
        .dot-red { background: #ff5f57; }
        .dot-yellow { background: #febc2e; }
        .dot-green { background: #28c840; }
        .window-titlebar h1 {
            flex: 1;
            text-align: center;
            font-size: 0.9rem;
            font-weight: 500;
            color: #aaa;
        }
        .window-content {
            padding: 24px;
            background: #0f3460;
        }
        .window-content p {
            line-height: 1.6;
            color: #ccc;
        }
    </style>
</head>
<body>
    <div class="window">
        <div class="window-titlebar">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
            <h1>{{ title }}</h1>
        </div>
        <div class="window-content">
            <p>Страница отрендерена через Twig.</p>
            <p style="margin-top:10px;">URL: {{ targetUrl }}</p>
            {% if jsResult %}
                <p style="margin-top:10px;">JS title: {{ jsResult.title }}</p>
                <p>JS readyState: {{ jsResult.readyState }}</p>
                <p>JS webdriver: {{ jsResult.webdriver is same as(null) ? 'null' : jsResult.webdriver ? 'true' : 'false' }}</p>
            {% endif %}
            {% if error %}
                <p style="margin-top:12px; color:#ffb4b4;">{{ error }}</p>
            {% endif %}
        </div>
    </div>
</body>
</html>
