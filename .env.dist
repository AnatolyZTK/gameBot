# Скопируйте в .env и задайте секреты: cp .env.dist .env
# На сервере: chmod +x scripts/deploy.sh && ./scripts/deploy.sh

APP_ENV=prod
APP_SECRET=

# Порт веб-интерфейса (8080 локально, 80 на сервере)
NGINX_HTTP_PORT=80

# MySQL (пароли сгенерируются deploy.sh, если пустые)
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=

REDIS_PORT=6379
MANTICORE_HTTP_PORT=9308
MANTICORE_MYSQL_PORT=9306
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Внутри Docker Compose (deploy.sh синхронизирует автоматически)
DATABASE_URL="mysql://app:@mysql:3306/app?serverVersion=8.0.32&charset=utf8mb4"
REDIS_URL=redis://redis:6379

MANTICORE_HOST=manticore
MANTICORE_PORT=9308

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=app-storage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true

# EA / FUT (заполните для переводов)
EA_LOGIN_EMAIL=
EA_LOGIN_PASSWORD=
EA_2FA_SECRET=
EA_HTTPS_PROXY=

# Парсинг / Futbin
GAME_SITE_BASE_URL=
GAME_SITE_REQUEST_DELAY_MS=1500
GAME_SITE_MAX_RETRIES=3

FUTBIN_BASE_URL=https://www.futbin.com
FUTBIN_GAME_VERSION=26
FUTBIN_REQUEST_DELAY_MS=1200
FUTBIN_COOKIES=

# URL для CLI (админка на сервере)
DEFAULT_URI=http://localhost

# Prod overlay для deploy.sh (можно не менять)
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
